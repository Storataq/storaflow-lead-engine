# Publiek (veilig voor browser + server met RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alleen server/worker — NOOIT in clientcode of als NEXT_PUBLIC_*
# Gebruik Secret key (sb_secret_...) of legacy service_role
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public support/contact email used in branding surfaces when
# organizations.support_email is empty. Default: info@storalabs.com
NEXT_PUBLIC_SUPPORT_EMAIL=info@storalabs.com

# Phase 21F outbound provider integration
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_TRACKING_SECRET=
EMAIL_REPLY_BASE_ADDRESS=

# Phase 21I preference center / unsubscribe / suppression automation
EMAIL_PREFERENCE_TOKEN_SECRET=
EMAIL_PREFERENCE_BASE_URL=
EMAIL_PREFERENCE_TOKEN_TTL_DAYS=365
EMAIL_ONE_CLICK_TOKEN_TTL_DAYS=90
EMAIL_RESUBSCRIBE_TOKEN_TTL_HOURS=48
EMAIL_PREFERENCE_RATE_LIMIT=60
EMAIL_PREFERENCE_STORE_IP=false
EMAIL_PREFERENCE_RETENTION_DAYS=730
EMAIL_COMPANY_ADDRESS_REQUIRED=true
EMAIL_LIST_UNSUBSCRIBE_ENABLED=true

# Phase 21E internal execution endpoints (scheduler/worker triggers).
# Set to a long random string. Never expose it to the browser.
EMAIL_EXECUTION_INTERNAL_SECRET=
# Optional identifier for worker logs / queue leases.
EMAIL_WORKER_ID=execution-worker

# Phase 21J analytics (optional)
EMAIL_ANALYTICS_ENABLED=
EMAIL_ANALYTICS_AGGREGATION_ENABLED=
EMAIL_ANALYTICS_DEFAULT_RANGE_DAYS=30
EMAIL_ANALYTICS_MAX_RANGE_DAYS=366
EMAIL_ANALYTICS_MIN_SAMPLE_SIZE=20
EMAIL_ANALYTICS_INSIGHTS_ENABLED=
EMAIL_ANALYTICS_CACHE_TTL_SECONDS=60
EMAIL_ANALYTICS_EXPORT_MAX_ROWS=5000
EMAIL_ANALYTICS_ATTRIBUTION_MODEL=last_touch
EMAIL_ANALYTICS_COSTS_ENABLED=

# Phase 21K AI assistance (optional; disabled unless EMAIL_AI_ENABLED=true)
EMAIL_AI_ENABLED=false
EMAIL_AI_PROVIDER=openai
EMAIL_AI_DEFAULT_MODEL=gpt-4.1-mini
EMAIL_AI_MAX_INPUT_TOKENS=12000
EMAIL_AI_MAX_OUTPUT_TOKENS=2048
EMAIL_AI_REQUEST_TIMEOUT_MS=45000
EMAIL_AI_MAX_RETRIES=1
EMAIL_AI_MONTHLY_BUDGET=
EMAIL_AI_STORE_RAW_RESPONSES=false
EMAIL_AI_STORE_PROMPTS=false
EMAIL_AI_RETENTION_DAYS=365
EMAIL_AI_REPLY_CLASSIFICATION_ENABLED=
EMAIL_AI_AUTO_ACTIONS_ENABLED=false
OPENAI_API_KEY=

# Phase 21L production hardening / operations (conservative defaults)
EMAIL_PRODUCTION_MODE=false
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT_ALLOWLIST=
EMAIL_SENDING_ENABLED=true
EMAIL_SCHEDULER_ENABLED=true
EMAIL_WORKER_ENABLED=true
EMAIL_PROVIDER_DISPATCH_ENABLED=false
EMAIL_WEBHOOK_PROCESSING_ENABLED=true
EMAIL_TRACKING_ENABLED=true
EMAIL_OPERATIONS_ENABLED=true
EMAIL_EMERGENCY_STOP=false
EMAIL_HEALTH_SECRET=
EMAIL_MAX_QUEUE_BACKLOG_WARNING=100
EMAIL_MAX_QUEUE_BACKLOG_CRITICAL=500
EMAIL_MAX_JOB_AGE_MINUTES=120
EMAIL_WORKER_HEARTBEAT_TIMEOUT_SECONDS=300
EMAIL_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
EMAIL_PROVIDER_FAILURE_THRESHOLD=5
EMAIL_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
EMAIL_RETENTION_JOBS_ENABLED=false
EMAIL_SUPPORT_BUNDLE_ENABLED=false

# Phase 25I — Integrations Marketplace
# AES-256-GCM key (32-byte base64 preferred). Never expose to the browser.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional shared secret for incoming marketplace webhooks (HMAC-SHA256).
INTEGRATIONS_WEBHOOK_SECRET=
# Internal sync worker trigger (same pattern as EMAIL_EXECUTION_INTERNAL_SECRET).
INTEGRATIONS_INTERNAL_SECRET=
# OAuth client credentials (per provider — leave empty until wiring live OAuth)
INTEGRATION_GOOGLE_CLIENT_ID=
INTEGRATION_GOOGLE_CLIENT_SECRET=
INTEGRATION_MS365_CLIENT_ID=
INTEGRATION_MS365_CLIENT_SECRET=
INTEGRATION_SLACK_CLIENT_ID=
INTEGRATION_SLACK_CLIENT_SECRET=
INTEGRATION_HUBSPOT_CLIENT_ID=
INTEGRATION_HUBSPOT_CLIENT_SECRET=

# Phase 26B — API & Webhook Platform
PLATFORM_API_INTERNAL_SECRET=
# Reuses INTEGRATIONS_ENCRYPTION_KEY for webhook secret encryption when set.

# Phase 26F — Billing & Subscription (Stripe). Never store raw card data.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 26G — Multi-Tenant Platform Admin (staff only; never customer-visible).
# Comma-separated emails allowed as bootstrap platform admins (in addition to platform_admins table).
PLATFORM_ADMIN_EMAILS=

# Phase 26H — PWA Web Push (optional). Never expose the private key to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@storalabs.com

# Phase 27A — AI Agent Platform (kernel workers + multi-provider)
# Internal worker: POST /api/internal/ai/worker-run with header x-ai-platform-secret
AI_PLATFORM_INTERNAL_SECRET=
AI_PLATFORM_WORKER_ENABLED=true
# Additional providers (OpenAI already covered by OPENAI_API_KEY above)
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
